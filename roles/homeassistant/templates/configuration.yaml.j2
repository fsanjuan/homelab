# {{ ansible_managed }}
#
# Owned by git (roles/homeassistant). Edits made on the server are overwritten
# on the next playbook run. Location, time zone, units and everything set up
# through the UI (integrations, devices, areas, users) live in .storage/ and are
# covered by Home Assistant's own backups, not by this file.

default_config:

homeassistant:
  # One file per feature in packages/ (heating.yaml, ev.yaml, ...)
  packages: !include_dir_named packages

# No `http:` section: Home Assistant now keeps HTTP settings in .storage/http
# (YAML is deprecated and only imported once). The port and reverse-proxy
# settings are enforced there by the playbook; see tasks/main.yml.

# Automations kept in git live in automations/; ones built in the UI editor go
# to automations.yaml (server-only, covered by backups). Move a UI automation
# into automations/ when you want it in git.
automation manual: !include_dir_merge_list automations/
automation ui: !include automations.yaml

script: !include scripts.yaml
scene: !include scenes.yaml
