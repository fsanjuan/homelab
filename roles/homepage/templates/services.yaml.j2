- Homelab:
    - Jenkins:
        href: https://{{ meshnet_hostname }}/jenkins
        description: CI/CD
        icon: jenkins
        server: my-docker
        container: jenkins-jenkins-1
    - Grafana:
        href: https://{{ meshnet_hostname }}/grafana
        description: Monitoring
        icon: grafana
        server: my-docker
        container: grafana
    - Home Assistant:
        href: https://{{ meshnet_hostname }}:8123
        description: Home automation
        icon: home-assistant
        server: my-docker
        container: homeassistant
{% if homeassistant_api_token is defined %}
        widget:
          type: homeassistant
          url: http://host.docker.internal:{{ homeassistant_internal_port }}
          key: {{ homeassistant_api_token }}
{% endif %}
